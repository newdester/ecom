{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/motorscent", "destination": "/motorscent.html" }
  ],
  "redirects": [
    { "source": "/cart", "destination": "/carrinho", "permanent": false },
    { "source": "/cart/(.*)", "destination": "/carrinho", "permanent": false },
    { "source": "/a/checkout", "destination": "/checkout", "permanent": false },
    { "source": "/collections/(.*)", "destination": "/", "permanent": false },
    { "source": "/products/(.*)", "destination": "/", "permanent": false },
    { "source": "/pages/(.*)", "destination": "/", "permanent": false },
    { "source": "/account/(.*)", "destination": "/", "permanent": false },
    { "source": "/customer_authentication/(.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
